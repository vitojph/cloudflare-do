{
	"$schema": "node_modules/wrangler/config-schema.json",
	"name": "durable-object-example",
	"main": "src/index.ts",
	"compatibility_date": "2026-10-06",
	"migrations": [
		{
			"new_sqlite_classes": [
				"DumbExample"
			],
			"tag": "v1"
		}
	],
	"durable_objects": {
		"bindings": [
			{
				"class_name": "DumbExample",
				"name": "DUMB_EXAMPLE"
			}
		]
	},
	"observability": {
		"enabled": true
	},
	"upload_source_maps": true
}
